    <!-- Help -->
    <string name="help_title">Help</string>
    <string name="help_intro">Short guide to each screen and control.</string>
    <string name="help_section_menu">Menu</string>
    <string name="help_menu_start">Opens the detection screen and starts the camera.</string>
    <string name="help_menu_settings">Opens general settings (feedback, camera options, language). Also available from the gear on Detect.</string>
    <string name="help_menu_about">Shows version, developer contact, disclaimer, help, and updates.</string>
    <string name="help_section_detect">Detect</string>
    <string name="help_detect_preview_title">Camera preview</string>
    <string name="help_detect_preview">Live camera view. Detection runs on the full frame on-device; nothing is saved or sent. Pinch with two fingers to zoom.</string>
    <string name="help_detect_guide_title">Guide line</string>
    <string name="help_detect_guide">Visual height reference only. With the line unlocked, swipe one finger up or down anywhere on the preview to move it. Use the lock button (line + padlock, above the zoom slider) to freeze it; it also locks automatically after 10 seconds without dragging.</string>
    <string name="help_detect_level">Vertical meter of current signal strength, with start and full thresholds.</string>
    <string name="help_detect_quick_title">Color / camera pills</string>
    <string name="help_detect_quick">Quick toggles for beam color (red/green) and front/back camera.</string>
    <string name="help_detect_zoom">Vertical slider on the lower right of the preview: up zooms in, down zooms out. Pinch on the preview also adjusts this value.</string>
    <string name="help_detect_sensitivity">Opens the Sensitivity panel with the session slider. Higher values detect weaker beams sooner.</string>
    <string name="help_detect_sensitivity_auto">Tunes sensitivity from the strongest dazzle in the current session. After 30 seconds without a dazzle, a new session starts.</string>
    <string name="help_detect_lock_exposure">Under Locks: locks auto-exposure and white balance so lighting stays stable while you aim.</string>
    <string name="help_detect_lock_focus">Under Locks: runs one focus pass, then holds focus.</string>
    <string name="help_detect_calibrate">Under Actions: recalibrates ambient baseline. Keep the beam out of view while calibrating.</string>
    <string name="help_detect_pocket">Under Actions: dims the screen and hides system bars for discreet use. Long-press to unlock.</string>
    <string name="help_detect_debug">Under Advanced: shows raw detection metrics on the preview for diagnostics.</string>
    <string name="help_detect_settings">Gear in the Detect top bar opens Settings without returning to the menu.</string>
    <string name="help_section_settings">Settings</string>
    <string name="help_setting_beep_style">Sound style used when a beam is detected.</string>
    <string name="help_setting_audio_stream">Alarm stream (can play over silent mode on many devices) or media stream. Use the device volume keys for loudness.</string>
    <string name="help_setting_vibrate">Vibrate in sync with beeps. Off by default on a fresh install.</string>
    <string name="help_setting_low_exposure">Biases the camera toward lower exposure to reduce bloom from bright beams.</string>
    <string name="help_setting_language">App language: system default, Hebrew, or English.</string>
